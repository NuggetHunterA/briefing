<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>Briefing · {{ e.edition }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300..900;1,400..700&display=swap" rel="stylesheet">
<style>
:root { --bg:#fff; --fg:#0a0a0a; --mute:#767676; --line:#0a0a0a; --hair:#e2e2e2; --red:#e30613; color-scheme: light; }
@media (prefers-color-scheme: dark) { :root { --bg:#0b0b0b; --fg:#f2f2f2; --mute:#8d8d8d; --line:#f2f2f2; --hair:#262626; --red:#ff3b30; color-scheme: dark; } }
*,*::before,*::after{box-sizing:border-box} h1,h2,h3,p,ol,ul,dl,dd{margin:0;padding:0} ol,ul{list-style:none} a{color:inherit;text-decoration:none} a:hover{color:var(--red)} img{display:block;max-width:100%}
body{margin:0;background:var(--bg);color:var(--fg);font:400 16px/1.4 "Inter Tight",Helvetica,Arial,sans-serif;font-feature-settings:"tnum","ss01";-webkit-font-smoothing:antialiased}
.wrap{max-width:1480px;margin:0 auto;padding:0 clamp(16px,3vw,48px)}
/* Kopf */
.top{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:0 24px;padding:clamp(16px,3vw,40px) 0 18px;border-bottom:6px solid var(--line);align-items:end}
.date{grid-column:1/8;font-weight:800;font-size:clamp(72px,15vw,220px);line-height:.78;letter-spacing:-.06em}
.date span{color:var(--red)}
.head-meta{grid-column:8/13;display:grid;gap:14px;font-weight:500;font-size:15px}
.head-meta b{display:block;font-size:clamp(26px,3vw,40px);font-weight:800;letter-spacing:-.03em;line-height:1}
.wx{display:flex;gap:16px;align-items:baseline;border-top:1px solid var(--line);padding-top:10px}
.wx .t{font-size:clamp(40px,5vw,64px);font-weight:300;letter-spacing:-.05em;line-height:.9}
.wx .c{color:var(--mute)}
.hours{display:grid;grid-template-columns:repeat(6,1fr);border-top:1px solid var(--hair);padding-top:8px;font-size:12px;color:var(--mute)}
.hours b{display:block;color:var(--fg);font-size:15px;font-weight:600}
.nav{display:flex;gap:22px;padding:12px 0;border-bottom:1px solid var(--line);font-weight:600;font-size:13px;overflow-x:auto;scrollbar-width:none;position:sticky;top:0;background:var(--bg);z-index:3}
.nav a span{color:var(--red);margin-right:4px}
/* Raster */
.grid{display:grid;grid-template-columns:minmax(0,1fr);gap:0 24px}
.sec{padding:22px 0 36px;border-bottom:1px solid var(--line)}
.sec-h{display:flex;align-items:baseline;gap:12px;margin-bottom:18px}
.sec-h .n{font-size:13px;font-weight:700;color:var(--red)}
.sec-h h2{font-size:28px;font-weight:800;letter-spacing:-.035em;line-height:1}
.sec-h .note{margin-left:auto;font-size:12px;color:var(--mute)}
.row{display:grid;grid-template-columns:52px minmax(0,1fr);gap:12px;padding:10px 0;border-top:1px solid var(--hair)}
.row:first-child{border-top:0}
.row .time{font-size:12px;color:var(--mute);padding-top:3px}
.row h3{font-size:17px;font-weight:600;letter-spacing:-.012em;line-height:1.22}
.row p{font-size:14px;color:var(--mute);margin-top:4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.row .src{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--mute);margin-top:6px}
.tag{display:inline-block;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;padding:2px 5px;margin-right:6px;vertical-align:2px;background:var(--fg);color:var(--bg)}
.tag.red{background:var(--red);color:#fff}
.lead h3{font-size:clamp(34px,4.6vw,72px);font-weight:800;letter-spacing:-.045em;line-height:.95;margin:6px 0 14px}
.lead .k{font-size:12px;font-weight:700;color:var(--red);text-transform:uppercase;letter-spacing:.08em}
.lead p{font-size:18px;line-height:1.4;max-width:46ch}
.lead img{width:100%;aspect-ratio:16/10;object-fit:cover;filter:grayscale(1) contrast(1.1);margin-bottom:16px}
.shield{font-size:12px;font-weight:600;color:var(--red);margin:-8px 0 12px}
table{width:100%;border-collapse:collapse;font-size:14px;margin-bottom:14px}
td,th{padding:6px 0 6px 14px;border-bottom:1px solid var(--hair);text-align:right}
th{font-size:11px;font-weight:600;color:var(--mute);text-align:right;border-bottom:1px solid var(--line)}
td:nth-child(2),th:nth-child(2){text-align:left;padding-left:10px;width:100%}
td:first-child,th:first-child{text-align:left}
tr.me td{font-weight:800;color:var(--red)}
.fix{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:14px;font-size:14px}
.fix b{display:block;font-size:11px;font-weight:600;color:var(--mute);text-transform:uppercase;letter-spacing:.06em}
.lr{display:grid;gap:24px}
.lr article{border-top:6px solid var(--fg);padding-top:12px}
.lr .num{font-size:64px;font-weight:200;line-height:.8;letter-spacing:-.05em;color:var(--red)}
.lr h3{font-size:24px;font-weight:700;letter-spacing:-.03em;line-height:1.08;margin:10px 0 8px}
.lr p{font-size:14.5px;color:var(--mute)}
.tx li{font-size:13.5px;padding:7px 0;border-top:1px solid var(--hair)}
.foot{padding:20px 0 40px;font-size:12px;color:var(--mute)}
@media (max-width:639px){
  .top{grid-template-columns:1fr}.date,.head-meta{grid-column:1}.date{margin-bottom:14px}
  .hours{grid-template-columns:repeat(6,1fr)}
}
@media (min-width:640px){
  .grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .s-welt,.s-lr{grid-column:1/-1}
  .s-welt .cols{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:24px}
  .lr{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media (min-width:640px) and (max-width:899px){ .s-welt .cols{grid-template-columns:1fr} }
@media (min-width:1180px){
  .grid{grid-template-columns:repeat(4,minmax(0,1fr))}
  .s-welt{grid-column:1/4}.s-wx{grid-column:4}
  .s-lr{grid-column:1/-1}.s-bb{grid-column:span 2}.s-more{grid-column:span 2}
}
</style>
</head>
<body>
<div class="wrap">
<header class="top">
  <h1 class="date">{{ '%02d'|format(now.day) }}<span>.</span>{{ '%02d'|format(now.month) }}<span>.</span></h1>
  <div class="head-meta">
    <div><b>{{ e.edition }}</b>{{ long_date(now) }} · {{ now|hhmm }} Uhr</div>
    {% if weather %}
    <div class="wx"><span class="t" data-live="temp">{{ weather.current.temperature_2m|num }}°</span><span><span data-live="cond">{{ weather.current.weather_code|wx }}</span><br><span class="c">{{ e.location.name }}{% if weather.days %} · {{ weather.days[0].max|num }}° / {{ weather.days[0].min|num }}°{% endif %}</span></span></div>
    <div class="hours">{% for h in weather.hours[:6] %}<span><b>{{ h.temp|num }}°</b>{{ h.time|hhmm }}{% if h.pp >= 20 %} · {{ h.pp }}%{% endif %}</span>{% endfor %}</div>
    {% endif %}
  </div>
</header>
<nav class="nav"><a href="#welt"><span>01</span>Welt</a><a href="#mlb"><span>02</span>MLB</a><a href="#nba"><span>03</span>NBA</a><a href="#fb"><span>04</span>Fußball</a><a href="#lr"><span>05</span>Lesestoff</a><a href="#bb"><span>06</span>Brandenburg</a></nav>

<main class="grid">
  <section class="sec s-welt" id="welt">
    <div class="sec-h"><span class="n">01</span><h2>Welt</h2></div>
    <div class="cols">
      {% if lead %}<div class="lead">{% if lead.image %}<img src="{{ lead.image }}" alt="" onerror="this.remove()">{% endif %}<div class="k">{{ lead.tag or lead.source }}</div><h3><a href="{{ lead.url }}">{{ lead.title }}</a></h3><p>{{ lead.summary }}</p></div>{% endif %}
      <ol>{% for it in welt_rest[:6] %}<li class="row"><span class="time">{{ it.published|hhmm }}</span><div><h3><a href="{{ it.url }}">{{ it.title }}</a></h3><div class="src">{{ it.source }}</div></div></li>{% endfor %}</ol>
    </div>
  </section>
  <section class="sec s-wx" id="wx">
    <div class="sec-h"><span class="n">00</span><h2>Wetter</h2></div>
    {% if weather %}<ol>{% for d in weather.days[:4] %}<li class="row"><span class="time">{{ WD_SHORT[d.date.weekday()] }}</span><div><h3>{{ d.max|num }}° / {{ d.min|num }}°</h3><p>{{ d.code|wx }}{% if d.pp %} · Regen {{ d.pp }}%{% endif %}</p></div></li>{% endfor %}</ol>{% endif %}
  </section>
  <section class="sec s-mlb" id="mlb">
    <div class="sec-h"><span class="n">02</span><h2>MLB</h2><span class="note">spoilerfrei</span></div>
    {% if e.hidden.mlb %}<p class="shield">{{ e.hidden.mlb }} Ergebnis-Meldungen ausgeblendet</p>{% endif %}
    <ol>{% for it in s.mlb %}<li class="row"><span class="time">{{ it.published|hhmm }}</span><div><h3>{% if it.favorite %}<span class="tag red">{{ favorites[it.favorite].name }}</span>{% endif %}<a href="{{ it.url }}">{{ it.title }}</a></h3>{% if loop.index <= 2 %}<p>{{ it.summary }}</p>{% endif %}</div></li>{% endfor %}</ol>
    {% if e.transactions %}<ul class="tx">{% for t in e.transactions[:4] %}<li><span class="tag">{{ t.type }}</span>{{ t.text }}</li>{% endfor %}</ul>{% endif %}
  </section>
  <section class="sec s-nba" id="nba">
    <div class="sec-h"><span class="n">03</span><h2>NBA</h2><span class="note">spoilerfrei</span></div>
    {% if e.hidden.nba %}<p class="shield">{{ e.hidden.nba }} Ergebnis-Meldungen ausgeblendet</p>{% endif %}
    <ol>{% for it in s.nba %}<li class="row"><span class="time">{{ it.published|hhmm }}</span><div><h3><a href="{{ it.url }}">{{ it.title }}</a></h3>{% if loop.index <= 2 %}<p>{{ it.summary }}</p>{% endif %}</div></li>{% endfor %}</ol>
  </section>
  <section class="sec s-fb" id="fb">
    <div class="sec-h"><span class="n">04</span><h2>Fußball</h2></div>
    {% set h = e.hertha %}{% if h %}
    <div class="fix">{% if h.last %}<div><b>Zuletzt</b>{{ h.last.home }} – {{ h.last.away }} {{ h.last.result }}</div>{% endif %}{% if h.next %}<div><b>Nächstes</b>{{ h.next.home }} – {{ h.next.away }}, {{ h.next.when|short_day }} {{ h.next.when|hhmm }}</div>{% endif %}</div>
    <table><tr><th>#</th><th>{{ h.league }}</th><th>Sp</th><th>Pkt</th></tr>{% for r in h.table %}<tr{% if r.hertha %} class="me"{% endif %}><td>{{ r.rank }}</td><td>{{ r.team }}</td><td>{{ r.games }}</td><td>{{ r.points }}</td></tr>{% endfor %}</table>{% endif %}
    <ol>{% for it in s.fussball[:5] %}<li class="row"><span class="time">{{ it.published|hhmm }}</span><div><h3>{% if it.hertha %}<span class="tag">Hertha</span>{% endif %}<a href="{{ it.url }}">{{ it.title }}</a></h3></div></li>{% endfor %}</ol>
  </section>
  <section class="sec s-lr" id="lr">
    <div class="sec-h"><span class="n">05</span><h2>Lesestoff</h2><span class="note">drei Texte für heute</span></div>
    <div class="lr">{% for it in e.longreads %}<article><div class="num">{{ loop.index }}</div><h3><a href="{{ it.url }}">{{ it.title }}</a></h3><p>{{ it.why or it.summary }}</p><div class="src" style="font-size:11px;font-weight:700;margin-top:10px;text-transform:uppercase;letter-spacing:.06em">{{ it.source }} →</div></article>{% endfor %}</div>
  </section>
  <section class="sec s-bb" id="bb">
    <div class="sec-h"><span class="n">06</span><h2>Brandenburg</h2></div>
    <ol>{% for it in s.brandenburg %}<li class="row"><span class="time">{{ it.published|hhmm }}</span><div><h3>{% if it.local %}<span class="tag red">Vor Ort</span>{% endif %}<a href="{{ it.url }}">{{ it.title }}</a></h3>{% if loop.index <= 2 %}<p>{{ it.summary }}</p>{% endif %}</div></li>{% endfor %}</ol>
  </section>
  <section class="sec s-more">
    <div class="sec-h"><span class="n">07</span><h2>Weitere Meldungen</h2></div>
    <ol>{% for it in welt_rest[6:] %}<li class="row"><span class="time">{{ it.published|hhmm }}</span><div><h3><a href="{{ it.url }}">{{ it.title }}</a></h3><div class="src">{{ it.source }}</div></div></li>{% endfor %}</ol>
  </section>
</main>
<footer class="foot">Briefing für Adrian · {{ e.edition }} · Nächste Ausgaben um 6, 13 und 19 Uhr · Alle Artikel verlinken auf die Originalquellen.</footer>
</div>
<script>window.BRIEFING={lat:{{ e.location.lat }},lon:{{ e.location.lon }}};</script><script src="app.js" defer></script>
</body></html>
