<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#0a0d0b">
<title>BRIEFING // {{ e.edition|upper }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#0a0d0b;--panel:#0f1411;--fg:#c9d4c5;--dim:#6b786a;--line:#1f2a22;--amber:#ffb000;--green:#3dff8f;--red:#ff5f56;--blue:#5fb4ff;color-scheme:dark}
*,*::before,*::after{box-sizing:border-box}h1,h2,h3,p,ol,ul{margin:0;padding:0}ol,ul{list-style:none}a{color:inherit;text-decoration:none}a:hover{color:var(--green);text-decoration:underline}
body{margin:0;background:var(--bg);color:var(--fg);font:400 13.5px/1.5 "JetBrains Mono",ui-monospace,monospace;-webkit-font-smoothing:antialiased}
body::after{content:"";position:fixed;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.18) 0 1px,transparent 1px 3px);mix-blend-mode:multiply}
.bar{display:flex;flex-wrap:wrap;gap:4px 18px;padding:8px 14px;background:var(--amber);color:#111;font-weight:800;font-size:12px;letter-spacing:.04em;position:sticky;top:0;z-index:3}
.bar .r{margin-left:auto}
.ticker{overflow:hidden;white-space:nowrap;border-bottom:1px solid var(--line);background:#070908;padding:6px 0;color:var(--amber);font-size:12.5px}
.ticker .t{display:inline-block;padding-left:100%;animation:tick 120s linear infinite}
.ticker span{margin-right:48px}.ticker span::before{content:"▲ ";color:var(--green)}
@keyframes tick{to{transform:translateX(-100%)}}
@media (prefers-reduced-motion:reduce){.ticker .t{animation:none;padding-left:14px}}
.grid{display:grid;gap:1px;background:var(--line);grid-template-columns:minmax(0,1fr);border-bottom:1px solid var(--line)}
.p{background:var(--panel);padding:14px 14px 18px;min-width:0}
.p h2{font-size:12px;font-weight:800;color:var(--amber);letter-spacing:.08em;margin-bottom:10px;display:flex;gap:10px}
.p h2::before{content:"■";color:var(--green)}
.p h2 small{margin-left:auto;color:var(--dim);font-weight:400}
.l li{display:grid;grid-template-columns:44px minmax(0,1fr);gap:10px;padding:5px 0;border-top:1px dashed var(--line)}
.l li:first-child{border-top:0}
.l .ts{color:var(--dim)}
.l .src{color:var(--dim);font-size:11.5px}
.l .sum{color:var(--dim);font-size:12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.fav{color:#111;background:var(--green);padding:0 4px;font-weight:800;font-size:11px;margin-right:6px}
.fav.a{background:var(--amber)}.fav.h{background:var(--blue)}
.shield{color:var(--red);font-size:12px;margin-bottom:8px}.shield::before{content:"[SPOILER-SHIELD] "}
.lead h3{font-size:clamp(18px,2.2vw,26px);line-height:1.25;color:#fff;font-weight:700;margin:4px 0 8px}
.lead .k{color:var(--green);font-size:12px}
.lead p{color:var(--fg)}
.big{font-size:clamp(46px,6vw,76px);font-weight:800;color:#fff;line-height:1;letter-spacing:-.04em}
.kv{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2px 16px;margin-top:10px}.kv span{color:var(--dim)}.kv b{color:var(--fg);font-weight:500;float:right}
.spark{display:flex;align-items:flex-end;gap:3px;height:56px;margin-top:14px}
.spark i{flex:1;background:var(--green);opacity:.75;min-height:2px}
.spark-l{display:flex;justify-content:space-between;color:var(--dim);font-size:11px;margin-top:3px}
table{width:100%;border-collapse:collapse;font-size:12.5px}td,th{padding:3px 0;text-align:right}th{color:var(--dim);font-weight:400;border-bottom:1px solid var(--line)}td:nth-child(2),th:nth-child(2){text-align:left;padding-left:8px}td:first-child,th:first-child{text-align:left;width:24px}
tr.me td{color:#111;background:var(--blue);font-weight:800}
.lr li{padding:10px 0;border-top:1px dashed var(--line)}.lr li:first-child{border-top:0}
.lr .n{color:var(--amber);font-weight:800}.lr h3{display:inline;font-size:14.5px;color:#fff}.lr p{color:var(--dim);font-size:12px;margin-top:4px}
.prompt{padding:16px 14px 40px;color:var(--dim);font-size:12px}
.prompt b{color:var(--green)}.cursor{display:inline-block;width:8px;height:14px;background:var(--green);vertical-align:-2px;animation:blink 1s steps(1) infinite}@keyframes blink{50%{opacity:0}}
@media (min-width:640px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.span2{grid-column:span 2}}
@media (min-width:1180px){.grid{grid-template-columns:repeat(4,minmax(0,1fr))}.span2{grid-column:span 2}.span3{grid-column:span 3}.tall{grid-row:span 2}}
</style>
</head>
<body>
<div class="bar"><span>BRIEFING/ADR</span><span>{{ WD_SHORT[now.weekday()]|upper }} {{ '%02d'|format(now.day) }}.{{ '%02d'|format(now.month) }}.{{ now.year }} {{ now|hhmm }}</span><span>{{ e.edition|upper }}</span><span class="r">SPOILER-SHIELD: ON</span></div>
<div class="ticker"><div class="t">{% for it in welt_rest[:8] %}<span>{{ it.title }}</span>{% endfor %}</div></div>
<main class="grid">
  <section class="p span3 lead">
    <h2>WELT <small>{{ s.welt|length }} ITEMS</small></h2>
    {% if lead %}<div class="k">&gt; {{ (lead.tag or lead.source)|upper }} · {{ lead.published|ago }}</div><h3><a href="{{ lead.url }}">{{ lead.title }}</a></h3><p>{{ lead.summary }}</p>{% endif %}
    <ol class="l" style="margin-top:12px">{% for it in welt_rest[:5] %}<li><span class="ts">{{ it.published|hhmm }}</span><span><a href="{{ it.url }}">{{ it.title }}</a> <span class="src">/{{ it.source }}</span></span></li>{% endfor %}</ol>
  </section>
  <section class="p tall">
    <h2>WX BRB <small>{{ e.location.lat }},{{ e.location.lon }}</small></h2>
    {% if weather %}
    <div class="big" data-live="temp">{{ weather.current.temperature_2m|num }}°</div>
    <div style="color:var(--green)" data-live="cond">{{ weather.current.weather_code|wx|upper }}</div>
    <div class="kv"><span>GEFÜHLT <b data-live="feels">{{ weather.current.apparent_temperature|num }}°</b></span><span>WIND <b>{{ weather.current.wind_speed_10m|num }} {{ weather.current.wind_direction_10m|compass }}</b></span><span>FEUCHTE <b>{{ weather.current.relative_humidity_2m|num }}%</b></span>{% if weather.days %}<span>SONNE <b>{{ weather.days[0].sunset|hhmm }}</b></span>{% endif %}</div>
    <div class="spark">{% for h in weather.hours %}<i style="height:{{ (12 + h.y * 88)|round|int }}%" title="{{ h.temp|num }}°"></i>{% endfor %}</div>
    <div class="spark-l"><span>{{ weather.hours[0].time|hhmm if weather.hours }}</span><span>TEMP 24H</span><span>{{ weather.hours[-1].time|hhmm if weather.hours }}</span></div>
    <ol class="l" style="margin-top:12px">{% for d in weather.days[1:4] %}<li><span class="ts">{{ WD_SHORT[d.date.weekday()]|upper }}</span><span>{{ d.max|num }}/{{ d.min|num }}° {{ d.code|wx|upper }}{% if d.pp and d.pp >= 30 %} <span style="color:var(--blue)">{{ d.pp }}%</span>{% endif %}</span></li>{% endfor %}</ol>
    {% endif %}
  </section>
  <section class="p">
    <h2>MLB <small>HOT STOVE</small></h2>
    {% if e.hidden.mlb %}<p class="shield">{{ e.hidden.mlb }} BLOCKED</p>{% endif %}
    <ol class="l">{% for it in s.mlb %}<li><span class="ts">{{ it.published|hhmm }}</span><span>{% if it.favorite %}<span class="fav{{ ' a' if it.favorite == 'athletics' }}">{{ 'SD' if it.favorite == 'padres' else 'ATH' }}</span>{% endif %}<a href="{{ it.url }}">{{ it.title }}</a></span></li>{% endfor %}</ol>
  </section>
  <section class="p">
    <h2>NBA <small>WIRE</small></h2>
    {% if e.hidden.nba %}<p class="shield">{{ e.hidden.nba }} BLOCKED</p>{% endif %}
    <ol class="l">{% for it in s.nba %}<li><span class="ts">{{ it.published|hhmm }}</span><span><a href="{{ it.url }}">{{ it.title }}</a></span></li>{% endfor %}</ol>
  </section>
  <section class="p">
    <h2>TXN <small>MLB STATS API</small></h2>
    <ol class="l">{% for t in e.transactions[:7] %}<li><span class="ts">{{ t.date[5:] if t.date }}</span><span><span style="color:var(--amber)">{{ t.type|upper }}</span> {{ t.text }}</span></li>{% endfor %}</ol>
  </section>
  <section class="p span2">
    <h2>FUSSBALL <small>HERTHA BSC</small></h2>
    {% set h = e.hertha %}{% if h %}
    <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px">
      <table><tr><th>#</th><th>{{ h.league|upper }}</th><th>SP</th><th>+/-</th><th>PKT</th></tr>{% for r in h.table %}<tr{% if r.hertha %} class="me"{% endif %}><td>{{ r.rank }}</td><td>{{ r.team|upper }}</td><td>{{ r.games }}</td><td>{{ '%+d'|format(r.diff) }}</td><td>{{ r.points }}</td></tr>{% endfor %}</table>
      <div>{% if h.last %}<div style="color:var(--dim)">LAST</div><div>{{ h.last.home|upper }} {{ h.last.result }} {{ h.last.away|upper }}</div>{% endif %}{% if h.next %}<div style="color:var(--dim);margin-top:8px">NEXT</div><div style="color:var(--green)">{{ h.next.home|upper }} – {{ h.next.away|upper }}<br>{{ h.next.when|short_day|upper }} {{ h.next.when|hhmm }}</div>{% endif %}</div>
    </div>{% endif %}
    <ol class="l" style="margin-top:12px">{% for it in s.fussball[:5] %}<li><span class="ts">{{ it.published|hhmm }}</span><span>{% if it.hertha %}<span class="fav h">BSC</span>{% endif %}<a href="{{ it.url }}">{{ it.title }}</a></span></li>{% endfor %}</ol>
  </section>
  <section class="p span2">
    <h2>BRANDENBURG <small>RBB24 / TAGESSCHAU</small></h2>
    <ol class="l">{% for it in s.brandenburg %}<li><span class="ts">{{ it.published|hhmm }}</span><span><a href="{{ it.url }}">{{ it.title }}</a>{% if loop.index <= 2 %}<span class="sum">{{ it.summary }}</span>{% endif %}</span></li>{% endfor %}</ol>
  </section>
  <section class="p span2 lr" style="grid-column:1/-1">
    <h2>LONGREADS <small>QUEUE FÜR HEUTE</small></h2>
    <ol>{% for it in e.longreads %}<li><span class="n">[{{ loop.index }}]</span> <h3><a href="{{ it.url }}">{{ it.title }}</a></h3> <span class="src" style="color:var(--dim)">/{{ it.source }}</span><p>{{ it.why or it.summary }}</p></li>{% endfor %}</ol>
  </section>
</main>
<div class="prompt"><b>adrian@briefing</b>:~$ naechste ausgabe 06:00 · 13:00 · 19:00 <span class="cursor"></span></div>
<script>window.BRIEFING={lat:{{ e.location.lat }},lon:{{ e.location.lon }}};</script><script src="app.js" defer></script>
</body></html>
